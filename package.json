{
  "name": "obsidian-rga-search",
  "version": "0.2.1",
  "description": "Full-text search inside the PDFs, EPUBs, Office files and Keynote decks in your vault, powered by ripgrep-all.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "test": "node esbuild.test.mjs && node --test test-dist/*.test.mjs",
    "test:e2e": "wdio run ./wdio.conf.mts",
    "typecheck:e2e": "tsc -p test/e2e/tsconfig.json",
    "lint": "eslint src",
    "lint:scanner": "eslint -c eslint.scanner.config.mjs .",
    "deploy": "node scripts/deploy.mjs"
  },
  "keywords": [
    "obsidian",
    "pdf",
    "full-text search",
    "ripgrep-all",
    "rga"
  ],
  "author": "Jesse Griffin",
  "license": "MIT",
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^20.19.43",
    "@wdio/cli": "^9.33.1",
    "@wdio/globals": "^9.33.1",
    "@wdio/local-runner": "^9.33.1",
    "@wdio/mocha-framework": "^9.33.1",
    "@wdio/spec-reporter": "^9.33.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.5.1",
    "obsidian": "^1.14.4",
    "tslib": "^2.9.1",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.2",
    "wdio-obsidian-reporter": "^3.5.0",
    "wdio-obsidian-service": "^3.5.0",
    "webdriverio": "^9.33.1"
  }
}
